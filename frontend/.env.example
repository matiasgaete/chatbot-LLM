# URL del backend que ejecuta el chatbot real.
# Vite reenvía /api a http://127.0.0.1:8000 (ver vite.config.js).
# Si no se define, la interfaz usa el modo demo local.
VITE_CHAT_API_URL=/api/chat

# Alternativa sin proxy: apunta directo al servidor FastAPI.
# VITE_CHAT_API_URL=http://localhost:8000/api/chat
